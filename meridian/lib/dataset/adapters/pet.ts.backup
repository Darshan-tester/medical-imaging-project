import path from "path";
import {
  parseCsv,
  pickColumn,
  readTextFileSafe,
  safeExists,
  stableId,
  walk,
} from "../fs-utils";
import {
  buildLookup,
  matchByIdentifiers,
} from "../report-matcher";
import {
  readDicomSummary,
  readNiftiSummary,
} from "../image-render";
import {
  AdapterIssue,
  AdapterResult,
  DatasetAdapter,
  DatasetImageRef,
  DatasetSeries,
  DatasetStudy,
} from "../types";
import {
  naturalSort,
  studyCode,
} from "./shared";

interface ReportRow {
  key?: string;
  text: string;
}

/**
 * PET dataset adapter.
 *
 * Supports:
 *   - DICOM PET series
 *   - Standalone NIfTI PET volumes
 *   - PETWB-REP report_en.csv
 *   - PETWB-REP master mapping CSV
 *
 * Important:
 * PET reports use identifiers such as:
 *
 *   983777-000001
 *
 * while NIfTI filenames look like:
 *
 *   sub-983777-000001_ses-01_desc-pet_suv.nii.gz
 *
 * Therefore report matching extracts the PET Image ID from the
 * NIfTI filename before attempting the match.
 *
 * This adapter does NOT calculate SUV.
 */
export const petAdapter: DatasetAdapter = {
  id: "PET",
  matchesDir: ["06_PET"],

  async scan(rootDir): Promise<AdapterResult> {
    const issues: AdapterIssue[] = [];

    if (!safeExists(rootDir)) {
      return {
        studies: [],
        issues,
      };
    }

    const csvFiles = [
      ...walk(rootDir, {
        extensions: [".csv"],
      }),
    ];

    const reportLookup = loadReports(
      csvFiles,
      issues
    );

    const studies: DatasetStudy[] = [];

    studies.push(
      ...scanDicom(
        rootDir,
        reportLookup,
        issues
      )
    );

    studies.push(
      ...scanNifti(
        rootDir,
        reportLookup,
        issues
      )
    );

    return {
      studies,
      issues,
    };
  },
};

/**
 * ---------------------------------------------------------------------------
 * DICOM PET
 * ---------------------------------------------------------------------------
 */
function scanDicom(
  rootDir: string,
  reportLookup: Map<string, ReportRow>,
  issues: AdapterIssue[]
): DatasetStudy[] {
  const dcmFiles = [
    ...walk(rootDir, {
      extensions: [".dcm"],
    }),
  ];

  type Instance = {
    absPath: string;
    summary: ReturnType<typeof readDicomSummary>;
  };

  const studies = new Map<
    string,
    Map<string, Instance[]>
  >();

  const meta = new Map<
    string,
    {
      accession?: string;
      bodyPart?: string;
      patientId?: string;
    }
  >();

  for (const file of dcmFiles) {
    const summary = readDicomSummary(file);

    if (!summary) {
      issues.push({
        dataset: "PET",
        path: file,
        reason: "Could not parse DICOM header",
      });

      continue;
    }

    const studyKey =
      summary.studyInstanceUID ||
      path.basename(
        path.dirname(
          path.dirname(file)
        )
      );

    const seriesKey =
      summary.seriesInstanceUID ||
      path.basename(
        path.dirname(file)
      );

    if (!studies.has(studyKey)) {
      studies.set(
        studyKey,
        new Map()
      );
    }

    const seriesMap =
      studies.get(studyKey)!;

    if (!seriesMap.has(seriesKey)) {
      seriesMap.set(seriesKey, []);
    }

    seriesMap
      .get(seriesKey)!
      .push({
        absPath: file,
        summary,
      });

    if (!meta.has(studyKey)) {
      meta.set(studyKey, {
        accession:
          summary.accessionNumber,
        bodyPart:
          summary.bodyPart,
      });
    }
  }

  const result: DatasetStudy[] = [];

  for (const [
    studyKey,
    seriesMap,
  ] of studies) {
    const series: DatasetSeries[] = [];

    let idx = 0;

    for (const [, instances] of seriesMap) {
      instances.sort((a, b) => {
        const an =
          a.summary?.instanceNumber ?? 0;

        const bn =
          b.summary?.instanceNumber ?? 0;

        return an !== bn
          ? an - bn
          : naturalSort(
              a.absPath,
              b.absPath
            );
      });

      idx++;

      const images: DatasetImageRef[] =
        instances.map(
          (inst, i) => ({
            id: stableId(
              studyKey,
              String(idx),
              String(i)
            ),
            index: i,
            kind: "dicom",
            absPath: inst.absPath,
            width:
              inst.summary?.columns,
            height:
              inst.summary?.rows,
          })
        );

      series.push({
        id: stableId(
          studyKey,
          String(idx)
        ),
        label: `Series ${idx}`,
        modality: "PET",
        orientation: "Axial",
        sliceCount:
          images.length,
        images,
      });
    }

    if (series.length === 0) {
      continue;
    }

    const m = meta.get(studyKey);

    const reportRow =
      matchByIdentifiers(
        reportLookup,
        [
          studyKey,
          m?.accession,
        ].filter(
          Boolean
        ) as string[]
      );

    const id = stableId(
      "PET",
      studyKey
    );

    result.push({
      id,
      dataset: "PET",
      studyCode: studyCode(
        "PET",
        studyKey
      ),
      sourceStudyId: studyKey,
      patientAlias:
        `Patient ${id
          .slice(0, 6)
          .toUpperCase()}`,
      modality: "PET",
      bodyRegion:
        m?.bodyPart,
      series,
      report: reportRow
        ? {
            source:
              "PETWB-REP",
            text:
              reportRow.text,
          }
        : undefined,
      sourceDir:
        rootDir,
    });
  }

  return result;
}

/**
 * ---------------------------------------------------------------------------
 * NIFTI PET
 * ---------------------------------------------------------------------------
 */
function scanNifti(
  rootDir: string,
  reportLookup: Map<string, ReportRow>,
  issues: AdapterIssue[]
): DatasetStudy[] {
  const niftiFiles = [
    ...walk(rootDir),
  ].filter(
    (f) =>
      f
        .toLowerCase()
        .endsWith(".nii") ||
      f
        .toLowerCase()
        .endsWith(".nii.gz")
  );

  const result: DatasetStudy[] = [];

  for (const file of niftiFiles) {
    const stem = path
      .basename(file)
      .replace(
        /\.nii(\.gz)?$/i,
        ""
      );

    const summary =
      readNiftiSummary(file);

    if (!summary) {
      issues.push({
        dataset: "PET",
        path: file,
        reason:
          "Could not read NIfTI header (invalid or corrupt file)",
      });

      continue;
    }

    const nz =
      summary.dims[2] || 1;

    const images: DatasetImageRef[] =
      Array.from(
        {
          length: nz,
        },
        (_, i) => ({
          id: stableId(
            "PET",
            stem,
            String(i)
          ),
          index: i,
          kind: "nifti",
          absPath: file,
          frameIndex: i,
          width:
            summary.dims[0],
          height:
            summary.dims[1],
        })
      );

    const series: DatasetSeries = {
      id: stableId(
        "PET",
        stem,
        "series"
      ),
      label: "Axial",
      modality: "PET",
      orientation: "Axial",
      sliceCount:
        images.length,
      images,
    };

    /**
     * Extract the PETWB-REP Image ID.
     *
     * Example:
     *
     * sub-983777-000001_ses-01_desc-pet_suv
     *
     * becomes:
     *
     * 983777-000001
     */
    const imageId =
      extractPetImageId(stem);

    /**
     * Try multiple identifiers.
     *
     * This makes matching tolerant of:
     *
     *   983777-000001
     *   sub-983777-000001
     *   sub-983777-000001_ses-01_desc-pet_suv
     */
    const identifiers = [
      stem,
      imageId,
      imageId
        ? `sub-${imageId}`
        : undefined,
    ].filter(
      Boolean
    ) as string[];

    const reportRow =
      matchByIdentifiers(
        reportLookup,
        identifiers
      );

    const id = stableId(
      "PET",
      "nifti",
      stem
    );

    result.push({
      id,
      dataset: "PET",
      studyCode: studyCode(
        "PET",
        imageId || stem
      ),
      sourceStudyId:
        imageId || stem,
      patientAlias:
        `Patient ${id
          .slice(0, 6)
          .toUpperCase()}`,
      modality: "PET",
      series: [series],

      report: reportRow
        ? {
            source:
              "PETWB-REP",
            text:
              reportRow.text,
          }
        : undefined,

      sourceDir:
        rootDir,
    });
  }

  return result;
}

/**
 * ---------------------------------------------------------------------------
 * Extract PET Image ID
 * ---------------------------------------------------------------------------
 *
 * Example:
 *
 * sub-983777-000001_ses-01_desc-pet_suv
 *
 * -> 983777-000001
 *
 * PETWB-REP report_en.csv uses this Image ID.
 */
function extractPetImageId(
  value: string
): string | undefined {
  const match =
    value.match(
      /(\d{6}-\d{6})/
    );

  return match
    ? match[1]
    : undefined;
}

/**
 * ---------------------------------------------------------------------------
 * Load PET reports
 * ---------------------------------------------------------------------------
 *
 * PETWB-REP contains CSVs such as:
 *
 * report_en.csv
 *
 * with columns:
 *
 *   Image ID
 *   Image description
 *   Report Diagnosis
 *
 * It may also contain:
 *
 * PETWB-REP_master_mapping.csv
 *
 * with columns:
 *
 *   Subject_ID
 *   Image_ID
 *   NIFTI_File
 *   Metadata_Match
 *   Report_Match
 *   Report_Diagnosis
 *
 * The previous adapter did not recognize these column names.
 */
function loadReports(
  csvFiles: string[],
  issues: AdapterIssue[]
): Map<string, ReportRow> {
  const rows: ReportRow[] = [];

  for (const csv of csvFiles) {
    const content =
      readTextFileSafe(csv);

    if (!content) {
      issues.push({
        dataset: "PET",
        path: csv,
        reason:
          "Unreadable CSV file",
      });

      continue;
    }

    let parsed: Record<
      string,
      string
    >[];

    try {
      parsed =
        parseCsv(content);
    } catch {
      issues.push({
        dataset: "PET",
        path: csv,
        reason:
          "Malformed CSV",
      });

      continue;
    }

    for (const row of parsed) {
      /**
       * IMPORTANT:
       *
       * PETWB-REP uses "Image ID".
       *
       * We support both the PET-specific
       * column names and the older generic
       * names.
       */
      const key =
        pickColumn(row, [
          "Image ID",
          "Image_ID",
          "image id",
          "image_id",

          "Subject_ID",
          "subject_id",

          "study_id",
          "accession",
          "accession_number",
          "id",
          "filename",
        ]);

      /**
       * PETWB-REP uses "Report Diagnosis".
       */
      const text =
        pickColumn(row, [
          "Report Diagnosis",
          "Report_Diagnosis",
          "report diagnosis",
          "report_diagnosis",

          "Image description",
          "Image_description",
          "image description",
          "image_description",

          "report",
          "findings",
          "impression",
          "text",
        ]);

      if (!key || !text) {
        continue;
      }

      const cleanKey =
        key.trim();

      const cleanText =
        text.trim();

      if (
        !cleanKey ||
        !cleanText
      ) {
        continue;
      }

      /**
       * Store the original key.
       */
      rows.push({
        key: cleanKey,
        text: cleanText,
      });

      /**
       * If this is a PET Image ID,
       * also store useful aliases.
       *
       * Example:
       *
       * 983777-000001
       *
       * aliases:
       *
       * sub-983777-000001
       */
      const imageId =
        extractPetImageId(
          cleanKey
        );

      if (imageId) {
        rows.push({
          key: imageId,
          text: cleanText,
        });

        rows.push({
          key: `sub-${imageId}`,
          text: cleanText,
        });
      }
    }
  }

  return buildLookup(
    rows,
    (r) => r.key
  );
}