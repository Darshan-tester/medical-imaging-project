# Copy this file to .env.local and fill in your local dataset path.
# .env.local is already gitignored — never commit real machine-specific paths.

# Absolute path to your local ScanLab dataset root. Read ONLY on the server
# (in lib/dataset/config.ts, the API routes, and the dataset:index /
# dataset:verify scripts) — it is never sent to the browser, since it is not
# prefixed NEXT_PUBLIC_.
#
# Windows example (matches the folder structure this build was integrated against):
SCANLAB_DATA_ROOT=D:\ScanLab_Datasets
# macOS/Linux example:
# SCANLAB_DATA_ROOT=/Users/you/ScanLab_Datasets

# "mock" (default) shows the existing seeded demo studies, exactly like
# before this integration. "dataset" shows real studies indexed from
# SCANLAB_DATA_ROOT instead. This IS sent to the browser (NEXT_PUBLIC_),
# since the UI needs to know which mode it's in.
NEXT_PUBLIC_DATA_MODE=mock

# Optional: where the generated manifest + ZIP-extraction cache live.
# Defaults to a `.scanlab/` folder at the project root (already gitignored).
# Point this at a drive with more free space once real volumes get large.
# SCANLAB_CACHE_DIR=D:\ScanLab_Cache
