# ==========================================
# Stale in-tree duplicate of this project
# ==========================================
# `/meridian/` is a full copy of this app (its own node_modules, package.json and
# pre-MPR .scanlab/manifest.json) that predates the dataset work. It was tracked
# in git — 130 of 276 files — and cloned on every Cloudflare build for nothing.
# Untracked with `git rm -r --cached meridian`; still present on disk.
# Leading slash matters: it pins the pattern to the repo root.

/meridian/

# ==========================================
# Working files that should never have been committed
# ==========================================

*.backup
*.backup-*
*-debug.txt
tsconfig.tsbuildinfo

# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ==========================================
# Local ScanLab generated data
# ==========================================

.scanlab/

# ==========================================
# Medical datasets
# ==========================================

# Every pattern here is root-anchored with a leading slash. Unanchored,
# `datasets/` also matched `app/api/datasets/`, so two real API routes
# (`/api/datasets` and `/api/datasets/status`) were silently excluded from the
# repo and never reached the Cloudflare build.

/ScanLab_Datasets/
/datasets/
/data/

# DICOM
*.dcm
*.dicom

# NIfTI / MRI
*.nii
*.nii.gz

# Medical image archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Large image files
*.tif
*.tiff
*.bmp

