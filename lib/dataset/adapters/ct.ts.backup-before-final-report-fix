import path from "path";

import {
  parseCsv,
  pickColumn,
  readTextFileSafe,
  safeExists,
  stableId,
  walk,
} from "../fs-utils";

import { buildLookup, matchByIdentifiers } from "../report-matcher";
import { readDicomSummary } from "../image-render";

import {
  AdapterIssue,
  AdapterResult,
  DatasetAdapter,
  DatasetImageRef,
  DatasetSeries,
  DatasetStudy,
  StudyReport,
} from "../types";

import { naturalSort, studyCode } from "./shared";
import { parseReportSections } from "../../report-utils";

interface ReportRow {
  key?: string;
  text: string;
  raw: Record<string, string>;
}

export const ctAdapter: DatasetAdapter = {
  id: "CT",
  matchesDir: ["02_CT"],

  async scan(rootDir): Promise<AdapterResult> {
    const issues: AdapterIssue[] = [];

    if (!safeExists(rootDir)) {
      return { studies: [], issues };
    }

    /*
     * Perle CT contains DICOM files with NO .dcm extension.
     */
    const candidateFiles = [...walk(rootDir)];

    /*
     * Load CSV/JSON reports plus Perle TXT reports.
     */
    const csvFiles = [
      ...walk(rootDir, {
        extensions: [".csv"],
      }),
    ];

    const jsonFiles = [
      ...walk(rootDir, {
        extensions: [".json"],
      }),
    ];

    const txtFiles = [
      ...walk(rootDir, {
        extensions: [".txt"],
      }),
    ];

    const reportLookup = loadReports(
      csvFiles,
      jsonFiles,
      txtFiles,
      issues
    );

    /*
     * studyKey -> seriesKey -> DICOM instances
     */
    type Instance = {
      absPath: string;
      summary: ReturnType<typeof readDicomSummary>;
    };

    const studies = new Map<
      string,
      Map<string, Instance[]>
    >();

    /*
     * Study-level metadata.
     */
    const studyMeta = new Map<
      string,
      {
        accession?: string;
        bodyPart?: string;
        date?: string;
      }
    >();

    /*
     * Read every candidate file.
     */
    for (const file of candidateFiles) {
      const summary = readDicomSummary(file);

      if (!summary) {
        continue;
      }

      /*
       * Prefer DICOM StudyInstanceUID.
       *
       * If unavailable, fall back to the dataset
       * folder structure:
       *
       * PA0_ct_chest/ST0/SE2/IM0
       */
      const studyKey =
        summary.studyInstanceUID ||
        path.basename(
          path.dirname(
            path.dirname(file)
          )
        );

      /*
       * Prefer DICOM SeriesInstanceUID.
       */
      const seriesKey =
        summary.seriesInstanceUID ||
        path.basename(
          path.dirname(file)
        );

      if (!studies.has(studyKey)) {
        studies.set(
          studyKey,
          new Map<string, Instance[]>()
        );
      }

      const seriesMap =
        studies.get(studyKey)!;

      if (!seriesMap.has(seriesKey)) {
        seriesMap.set(
          seriesKey,
          []
        );
      }

      seriesMap
        .get(seriesKey)!
        .push({
          absPath: file,
          summary,
        });

      /*
       * Save study metadata once.
       */
      if (!studyMeta.has(studyKey)) {
        studyMeta.set(
          studyKey,
          {
            accession:
              summary.accessionNumber,

            bodyPart:
              summary.bodyPart,

            date:
              normalizeDicomDate(
                summary.studyDate
              ),
          }
        );
      }
    }

    /*
     * Convert grouped DICOM files into DatasetStudy objects.
     */
    const result: DatasetStudy[] = [];

    for (const [
      studyKey,
      seriesMap,
    ] of studies) {
      const series: DatasetSeries[] = [];

      let seriesIdx = 0;

      for (const [
        seriesKey,
        instances,
      ] of seriesMap) {
        /*
         * Sort CT slices.
         */
        instances.sort(
          (a, b) => {
            const an =
              a.summary?.instanceNumber;

            const bn =
              b.summary?.instanceNumber;

            if (
              an !== undefined &&
              bn !== undefined &&
              an !== bn
            ) {
              return an - bn;
            }

            const asl =
              a.summary?.sliceLocation;

            const bsl =
              b.summary?.sliceLocation;

            if (
              asl !== undefined &&
              bsl !== undefined &&
              asl !== bsl
            ) {
              return asl - bsl;
            }

            return naturalSort(
              a.absPath,
              b.absPath
            );
          }
        );

        /*
         * Convert DICOM instances to viewer images.
         */
        const images: DatasetImageRef[] =
          instances.map(
            (inst, index) => ({
              id: stableId(
                seriesKey,
                String(index)
              ),

              index,

              kind: "dicom",

              absPath:
                inst.absPath,

              width:
                inst.summary?.columns,

              height:
                inst.summary?.rows,
            })
          );

        seriesIdx++;

        series.push({
          id: stableId(
            studyKey,
            seriesKey
          ),

          label:
            instances[0]?.summary
              ?.seriesDescription ||
            `Series ${seriesIdx}`,

          modality: "CT",

          orientation: "Axial",

          sliceCount:
            images.length,

          images,
        });
      }

      if (series.length === 0) {
        continue;
      }

      const meta =
        studyMeta.get(studyKey);

      /*
       * Match report using:
       *
       * 1. StudyInstanceUID
       * 2. Accession
       * 3. Dataset folder/study ID
       *
       * The third identifier is important for
       * Perle CT because the report is associated
       * with PA0_ct_chest, PA1_ct_brain, etc.
       */
      const folderStudyKey =
        getDatasetStudyKey(
          studyKey,
          seriesMap
        );

      const reportRow =
        matchByIdentifiers(
          reportLookup,
          [
            studyKey,
            meta?.accession,
            folderStudyKey,
          ]
        );

      /*
       * Build a structured report while preserving
       * the complete original report text.
       */
      const report:
        | StudyReport
        | undefined =
        reportRow
          ? (() => {
              const sections =
                parseReportSections(
                  reportRow.text
                );

              return {
                source: "Perle CT",

                /*
                 * Always preserve the original
                 * complete report.
                 */
                text: reportRow.text,

                /*
                 * Structured report sections.
                 */
                clinicalInformation:
                  sections.clinicalInformation,

                technique:
                  sections.technique,

                findings:
                  sections.findings,

                impression:
                  sections.impression,

                comparison:
                  sections.comparison,
              };
            })()
          : undefined;

      const id =
        stableId(
          "CT",
          studyKey
        );

      result.push({
        id,

        dataset: "CT",

        studyCode:
          studyCode(
            "CT",
            studyKey
          ),

        sourceStudyId:
          studyKey,

        patientAlias:
          `Patient ${id
            .slice(0, 6)
            .toUpperCase()}`,

        modality: "CT",

        bodyRegion:
          meta?.bodyPart,

        date:
          meta?.date,

        series,

        report,

        sourceDir:
          rootDir,
      });
    }

    return {
      studies: result,
      issues,
    };
  },
};

/**
 * Convert DICOM YYYYMMDD into YYYY-MM-DD.
 */
function normalizeDicomDate(
  value?: string
): string | undefined {
  if (
    !value ||
    value.length !== 8
  ) {
    return undefined;
  }

  return (
    `${value.slice(0, 4)}-` +
    `${value.slice(4, 6)}-` +
    `${value.slice(6, 8)}`
  );
}

/**
 * Extract the dataset study identifier from
 * a Perle CT path.
 *
 * Example:
 *
 * .../ct_general/PA0_ct_chest/ST0/SE2/IM0
 *
 * returns:
 *
 * PA0_ct_chest
 */
function getDatasetStudyKey(
  studyKey: string,
  seriesMap: Map<string, any>
): string | undefined {
  for (const instances of seriesMap.values()) {
    const first =
      instances?.[0];

    if (!first?.absPath) {
      continue;
    }

    const normalized =
      first.absPath.replace(
        /\\/g,
        "/"
      );

    const marker =
      "/ct_general/";

    const markerIndex =
      normalized.indexOf(
        marker
      );

    if (markerIndex >= 0) {
      const remainder =
        normalized.slice(
          markerIndex +
            marker.length
        );

      const parts =
        remainder.split("/");

      if (parts.length > 0) {
        return parts[0];
      }
    }
  }

  /*
   * If the study key itself is already
   * a dataset identifier, use it.
   */
  if (
    /^PA\d+_ct_/i.test(
      studyKey
    )
  ) {
    return studyKey;
  }

  return undefined;
}

/**
 * Load CT reports from:
 *
 * CSV
 * JSON
 * TXT
 */
function loadReports(
  csvFiles: string[],
  jsonFiles: string[],
  txtFiles: string[],
  issues: AdapterIssue[]
): Map<string, ReportRow> {
  const rows: ReportRow[] = [];

  /*
   * CSV reports.
   */
  for (const csv of csvFiles) {
    const content =
      readTextFileSafe(csv);

    if (!content) {
      issues.push({
        dataset: "CT",
        path: csv,
        reason:
          "Unreadable CSV file",
      });

      continue;
    }

    let parsed:
      Record<string, string>[];

    try {
      parsed =
        parseCsv(content);
    } catch {
      issues.push({
        dataset: "CT",
        path: csv,
        reason:
          "Malformed CSV",
      });

      continue;
    }

    for (const row of parsed) {
      const key =
        pickColumn(
          row,
          [
            "studyinstanceuid",
            "study_instance_uid",
            "accession",
            "accession_number",
            "study_id",
            "subject_id",
            "id",
          ]
        );

      const text =
        pickColumn(
          row,
          [
            "report",
            "findings",
            "impression",
            "text",
            "narrative",
          ]
        );

      if (key && text) {
        rows.push({
          key,
          text,
          raw: row,
        });
      }
    }
  }

  /*
   * JSON reports.
   */
  for (const jsonFile of jsonFiles) {
    const content =
      readTextFileSafe(
        jsonFile
      );

    if (!content) {
      continue;
    }

    try {
      const data =
        JSON.parse(content);

      const entries =
        Array.isArray(data)
          ? data
          : Object.values(data);

      for (const entry of entries as any[]) {
        const key =
          entry.StudyInstanceUID ??
          entry.study_instance_uid ??
          entry.accession_number ??
          entry.study_id ??
          entry.subject_id ??
          entry.id;

        const text =
          entry.report ??
          entry.findings ??
          entry.impression ??
          entry.text;

        if (key && text) {
          rows.push({
            key: String(key),
            text: String(text),
            raw: entry,
          });
        }
      }
    } catch {
      issues.push({
        dataset: "CT",
        path: jsonFile,
        reason:
          "Malformed JSON",
      });
    }
  }

  /*
   * Perle CT TXT reports.
   *
   * Example:
   *
   * PA0_ct_chest/
   *   ...report.txt
   *
   * We derive the subject/study ID from
   * the directory structure.
   */
  for (const txtFile of txtFiles) {
    const content =
      readTextFileSafe(
        txtFile
      );

    if (!content?.trim()) {
      continue;
    }

    const key =
      getTxtStudyKey(
        txtFile
      );

    if (!key) {
      continue;
    }

    rows.push({
      key,
      text: content.trim(),
      raw: {
        sourceFile:
          txtFile,
      },
    });
  }

  return buildLookup(
    rows,
    (row) => row.key
  );
}

/**
 * Extract PA0_ct_chest / PA1_ct_brain
 * from a Perle CT report path.
 */
function getTxtStudyKey(
  txtFile: string
): string | undefined {
  const normalized =
    txtFile.replace(
      /\\/g,
      "/"
    );

  /*
   * Preferred structure:
   *
   * .../ct_general/PA0_ct_chest/report.txt
   */
  const marker =
    "/ct_general/";

  const markerIndex =
    normalized.indexOf(
      marker
    );

  if (markerIndex >= 0) {
    const remainder =
      normalized.slice(
        markerIndex +
          marker.length
      );

    const parts =
      remainder.split("/");

    if (
      parts.length > 0 &&
      /^PA\d+_ct_/i.test(
        parts[0]
      )
    ) {
      return parts[0];
    }
  }

  /*
   * Inspection reports:
   *
   * .../inspection/PA0_ct_chest/report.txt
   */
  const inspectionMarker =
    "/inspection/";

  const inspectionIndex =
    normalized.indexOf(
      inspectionMarker
    );

  if (inspectionIndex >= 0) {
    const remainder =
      normalized.slice(
        inspectionIndex +
          inspectionMarker.length
      );

    const parts =
      remainder.split("/");

    if (
      parts.length > 0 &&
      /^PA\d+_ct_/i.test(
        parts[0]
      )
    ) {
      return parts[0];
    }
  }

  return undefined;
}
