import path from "path";
import {
  parseCsv,
  pickColumn,
  readTextFileSafe,
  safeExists,
  stableId,
  walk,
} from "../fs-utils";
import { buildLookup, matchByIdentifiers } from "../report-matcher";
import { readDicomSummary, readNiftiSummary } from "../image-render";
import {
  AdapterIssue,
  AdapterResult,
  DatasetAdapter,
  DatasetImageRef,
  DatasetSeries,
  DatasetStudy,
} from "../types";
import { naturalSort, studyCode } from "./shared";

interface ReportRow {
  key?: string;
  text: string;
}

/**
 * PET studies are indexed as:
 *
 * 1. DICOM series grouped by StudyInstanceUID / SeriesInstanceUID.
 * 2. Standalone NIfTI volumes, where each NIfTI becomes one axial series.
 *
 * PETWB-REP reports are matched using the Image ID contained in
 * report_en.csv.
 *
 * Example:
 *
 * NIfTI:
 *   sub-983777-000001_ses-01_desc-pet_suv.nii.gz
 *
 * Derived Image ID:
 *   983777-000001
 *
 * report_en.csv:
 *   Image ID = 983777-000001
 *
 * Therefore:
 *   NIfTI -> Image ID -> Report Diagnosis
 *
 * This adapter does not calculate or display SUV values.
 */
export const petAdapter: DatasetAdapter = {
  id: "PET",
  matchesDir: ["06_PET"],

  async scan(rootDir): Promise<AdapterResult> {
    const issues: AdapterIssue[] = [];

    if (!safeExists(rootDir)) {
      return { studies: [], issues };
    }

    const csvFiles = [...walk(rootDir, { extensions: [".csv"] })];

    const reportLookup = loadReports(csvFiles, issues);

    const studies: DatasetStudy[] = [];

    // Existing DICOM support
    studies.push(...scanDicom(rootDir, reportLookup, issues));

    // PETWB-REP NIfTI support
    studies.push(...scanNifti(rootDir, reportLookup, issues));

    return {
      studies,
      issues,
    };
  },
};

function scanDicom(
  rootDir: string,
  reportLookup: Map<string, ReportRow>,
  issues: AdapterIssue[],
): DatasetStudy[] {
  const dcmFiles = [...walk(rootDir, { extensions: [".dcm"] })];

  type Instance = {
    absPath: string;
    summary: ReturnType<typeof readDicomSummary>;
  };

  const studies = new Map<string, Map<string, Instance[]>>();

  const meta = new Map<
    string,
    {
      accession?: string;
      bodyPart?: string;
    }
  >();

  for (const file of dcmFiles) {
    const summary = readDicomSummary(file);

    if (!summary) {
      issues.push({
        dataset: "PET",
        path: file,
        reason: "Could not parse DICOM header",
      });

      continue;
    }

    const studyKey =
      summary.studyInstanceUID ||
      path.basename(path.dirname(path.dirname(file)));

    const seriesKey =
      summary.seriesInstanceUID ||
      path.basename(path.dirname(file));

    if (!studies.has(studyKey)) {
      studies.set(studyKey, new Map());
    }

    const seriesMap = studies.get(studyKey)!;

    if (!seriesMap.has(seriesKey)) {
      seriesMap.set(seriesKey, []);
    }

    seriesMap.get(seriesKey)!.push({
      absPath: file,
      summary,
    });

    if (!meta.has(studyKey)) {
      meta.set(studyKey, {
        accession: summary.accessionNumber,
        bodyPart: summary.bodyPart,
      });
    }
  }

  const result: DatasetStudy[] = [];

  for (const [studyKey, seriesMap] of studies) {
    const series: DatasetSeries[] = [];

    let idx = 0;

    for (const [, instances] of seriesMap) {
      instances.sort((a, b) => {
        const an = a.summary?.instanceNumber ?? 0;
        const bn = b.summary?.instanceNumber ?? 0;

        return an !== bn
          ? an - bn
          : naturalSort(a.absPath, b.absPath);
      });

      idx++;

      const images: DatasetImageRef[] = instances.map((inst, i) => ({
        id: stableId(studyKey, String(idx), String(i)),
        index: i,
        kind: "dicom",
        absPath: inst.absPath,
        width: inst.summary?.columns,
        height: inst.summary?.rows,
      }));

      series.push({
        id: stableId(studyKey, String(idx)),
        label: `Series ${idx}`,
        modality: "PET",
        orientation: "Axial",
        sliceCount: images.length,
        images,
      });
    }

    if (series.length === 0) {
      continue;
    }

    const m = meta.get(studyKey);

    const reportRow = matchByIdentifiers(reportLookup, [
      studyKey,
      m?.accession,
    ]);

    const id = stableId("PET", studyKey);

    result.push({
      id,
      dataset: "PET",
      studyCode: studyCode("PET", studyKey),
      sourceStudyId: studyKey,
      patientAlias: `Patient ${id.slice(0, 6).toUpperCase()}`,
      modality: "PET",
      bodyRegion: m?.bodyPart,
      series,
      report: reportRow
        ? {
            source: "PET dataset",
            text: reportRow.text,
          }
        : undefined,
      sourceDir: rootDir,
    });
  }

  return result;
}

function scanNifti(
  rootDir: string,
  reportLookup: Map<string, ReportRow>,
  issues: AdapterIssue[],
): DatasetStudy[] {
  const niftiFiles = [...walk(rootDir)].filter(
    (f) =>
      f.toLowerCase().endsWith(".nii") ||
      f.toLowerCase().endsWith(".nii.gz"),
  );

  const result: DatasetStudy[] = [];

  for (const file of niftiFiles) {
    const stem = path
      .basename(file)
      .replace(/\.nii(\.gz)?$/i, "");

    const summary = readNiftiSummary(file);

    if (!summary) {
      issues.push({
        dataset: "PET",
        path: file,
        reason:
          "Could not read NIfTI header (invalid or corrupt file)",
      });

      continue;
    }

    const nz = summary.dims[2] || 1;

    const images: DatasetImageRef[] = Array.from(
      { length: nz },
      (_, i) => ({
        id: stableId("PET", stem, String(i)),
        index: i,
        kind: "nifti",
        absPath: file,
        frameIndex: i,
        width: summary.dims[0],
        height: summary.dims[1],
      }),
    );

    const series: DatasetSeries = {
      id: stableId("PET", stem, "series"),
      label: "Axial",
      modality: "PET",
      orientation: "Axial",
      sliceCount: images.length,
      images,
    };

    /**
     * PETWB-REP filename example:
     *
     * sub-983777-000001_ses-01_desc-pet_suv
     *
     * report_en.csv:
     *
     * Image ID = 983777-000001
     *
     * Convert:
     *
     * sub-983777-000001_ses-01_desc-pet_suv
     *             ↓
     * 983777-000001
     */
    const imageId = stem
      .replace(/^sub-/i, "")
      .replace(/_ses-.*$/i, "");

    /**
     * Try both:
     *
     * 1. Actual PET Image ID
     * 2. Original filename stem
     *
     * The first one is the important deterministic match for PETWB-REP.
     */
    const reportRow = matchByIdentifiers(reportLookup, [
      imageId,
      stem,
    ]);

    const id = stableId("PET", "nifti", stem);

    result.push({
      id,
      dataset: "PET",
      studyCode: studyCode("PET", imageId),
      sourceStudyId: imageId,
      patientAlias: `Patient ${id.slice(0, 6).toUpperCase()}`,
      modality: "PET",
      series: [series],

      report: reportRow
        ? {
            source: "PETWB-REP",
            text: reportRow.text,
          }
        : undefined,

      sourceDir: rootDir,
    });
  }

  return result;
}

function loadReports(
  csvFiles: string[],
  issues: AdapterIssue[],
): Map<string, ReportRow> {
  const rows: ReportRow[] = [];

  for (const csv of csvFiles) {
    const content = readTextFileSafe(csv);

    if (!content) {
      issues.push({
        dataset: "PET",
        path: csv,
        reason: "Unreadable CSV file",
      });

      continue;
    }

    let parsed: Record<string, string>[];

    try {
      parsed = parseCsv(content);
    } catch {
      issues.push({
        dataset: "PET",
        path: csv,
        reason: "Malformed CSV",
      });

      continue;
    }

    for (const row of parsed) {
      /**
       * PETWB-REP report_en.csv uses:
       *
       * Image ID
       * Image description
       * Report Diagnosis
       *
       * pickColumn() is case/format aware according to the
       * existing CSV utility, so we explicitly support both
       * the PETWB-REP names and the generic report names.
       */

      const key = pickColumn(row, [
        "study_id",
        "accession",
        "accession_number",
        "id",
        "filename",
        "image id",
        "image_id",
      ]);

      /**
       * IMPORTANT:
       *
       * Report Diagnosis is preferred because this is the actual
       * diagnostic conclusion from report_en.csv.
       *
       * Image description is retained as a fallback.
       */
      const text = pickColumn(row, [
        "report diagnosis",
        "report",
        "findings",
        "impression",
        "text",
        "image description",
      ]);

      if (key && text) {
        rows.push({
          key,
          text,
        });
      }
    }
  }

  return buildLookup(rows, (r) => r.key);
}